# Copy to ~/.gemini/agy-gateway.env and fill in the key:
#   cp agy-gateway.env.example ~/.gemini/agy-gateway.env && chmod 600 ~/.gemini/agy-gateway.env
#
# hub-wrapper.sh sources this file for sessions that run on the local gateway (--hub, and any
# session started with --settings '{"modelProvider":"gemini"}'); diagnostics/cache_ttl_probe.py
# reads CPA_API_KEY from it. It is shell syntax: KEY=value, no spaces around `=`.

# Required: an API key your CLIProxyAPI accepts.
CPA_API_KEY=

# Optional. Each line below shows the default hub-wrapper.sh uses; uncomment one to override it.
# GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:5233
# AGY_LLM_GATEWAY_URL=http://127.0.0.1:5233
# AGY_LLM_GATEWAY_WIRE_PROTOCOL=genai

# The model picker, as comma-separated catalog IDs.
# AGY_LLM_GATEWAY_MODELS=gemini-4-carbon-low,gemini-4-carbon-medium,gemini-4-carbon-high,gemini-4-argon-low,gemini-4-argon-medium,gemini-4-argon-high,gemini-4-hydrogen-low,gemini-4-hydrogen-medium,gemini-4-hydrogen-high,gemini-4-hydrogen-xhigh,gemini-3.8-flash-medium,gemini-3.8-flash-high

# Background tiers: titles and command safety checks (flash_lite), subagents (flash, pro).
# AGY_LLM_GATEWAY_TIER_FLASH_LITE=gemini-4-hydrogen-low
# AGY_LLM_GATEWAY_TIER_FLASH=gemini-4-hydrogen-high
# AGY_LLM_GATEWAY_TIER_PRO=gemini-4-carbon-medium
